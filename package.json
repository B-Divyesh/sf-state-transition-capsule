{
  "name": "state-transition-capsule",
  "version": "0.1.0",
  "description": "Capture, redact, replay, and compare application state transitions.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/package/index.cjs",
  "module": "./dist/package/index.js",
  "types": "./dist/package/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/package/index.d.ts",
      "import": "./dist/package/index.js",
      "require": "./dist/package/index.cjs"
    }
  },
  "files": [
    "dist/package",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "vite --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "build:lib": "tsup src/index.ts --format esm,cjs --dts --out-dir dist/package",
    "build:site": "vite build --config vite.config.ts",
    "build": "npm run clean && npm run build:lib && npm run build:site",
    "test:unit": "vitest run --root . tests/core.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:production": "PLAYWRIGHT_PRODUCTION=1 playwright test -g 'production offline shell'",
    "test": "npm run test:unit && npm run build && npm run test:e2e && npm run test:e2e:production",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "state",
    "debugging",
    "replay",
    "diff",
    "local-first"
  ],
  "author": "Sociobot (Param Factory)",
  "license": "MIT",
  "homepage": "https://state-transition-capsule.sociobot.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B-Divyesh/sf-state-transition-capsule.git"
  },
  "bugs": {
    "url": "https://github.com/B-Divyesh/sf-state-transition-capsule/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@fontsource-variable/bricolage-grotesque": "^5.1.1",
    "@fontsource/ibm-plex-mono": "^5.1.1",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.10.7",
    "playwright-core": "1.58.2",
    "tsup": "^8.5.0",
    "typescript": "5.7.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.7"
  }
}
